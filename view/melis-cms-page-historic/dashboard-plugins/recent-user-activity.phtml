<?php if($this->isAccessable) { ?>
    <div class="widget-activity">
        <?php
            if ($this->isCmsActive){
        ?>
            <ul class="list">
                <?php
                    foreach ($this->pages as $page)
                    {
                        $tagsOpening = 'class="disable-widget-hover"';
                        if ($page['page_accessible'])
                            // Sécurité : page_name/page_icon (titre de page, éditable dans l'outil Pages)
                            // sont injectés dans des attributs data-* → escapeHtmlAttr pour empêcher une
                            // sortie d'attribut (XSS stocké rendu sur le tableau de bord de chaque admin).
                            $tagsOpening = 'class="melis-openrecenthistoric" data-page-title="' . $this->escapeHtmlAttr($page['page_name']) . '"  data-page-icon="' . $this->escapeHtmlAttr($page['page_icon']) . '" data-zone-id="' . $this->escapeHtmlAttr($page['page_id']) . '_' . $this->escapeHtmlAttr($this->pageId) . '" data-melis-key="' . $this->escapeHtmlAttr($this->pageMelisKey) . '" data-page-id="' . $this->escapeHtmlAttr($page['page_id']) . '"';

                        $histActionIcon = '';
                        if (!empty($page['hist_action_icon']))
                            $histActionIcon = '<span class="' . $page['hist_action_icon'] . '"></span>';
                ?>
                    <li <?= $tagsOpening; ?>>
                        <span ><?= $page['hist_date']; ?> :
                            <?= $histActionIcon; ?>
                            <span class="ra-username"><?= $this->escapeHtml($page['page_name']); ?> (<?= $this->escapeHtml($page['page_id']); ?>)</span>,
                            <?= $this->escapeHtml($page['hist_action']); ?>,
                            <span class="ra-username"><?= $this->escapeHtml($page['hist_user_name']); ?></span>.
                        </span>
                        <div class="clearfix"></div>
                    </li>
                <?php
                    }
                ?>
            </ul>
        <?php
            }else{
        ?>
            <div class="alert alert-warning">
                <p><?php $this->translate('tr_melispagehistoric_dashboard_recent_activity_Pages_meliscms_deactivated')?> </p>
            </div>
        <?php }?>
    </div>
<?php } else { ?>
    <div class="no-rights-container">
        <span><?= $this->translate('tr_melisdashboardplugin_plugin_no_rights'); ?></span>
    </div>
<?php } ?>
